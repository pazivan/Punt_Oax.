# Copiar a .env local y reemplazar ambos valores por secretos distintos.
SPRINT4_DB_PASSWORD=crear_password_aleatorio_para_la_base_nueva
JWT_SECRET=crear_clave_jwt_aleatoria_de_al_menos_32_caracteres

# Verificación del dominio de los correos al registrarse (MX/A vía DNS).
# 1 = activa (predeterminado); 0 = desactivada (útil sin red o en pruebas).
PUNTOAX_VERIFICAR_DOMINIO_CORREO=1

# Correo transaccional: solo backend; no incluir valores reales en Git.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=notificaciones@puntoax.online
# BREVO_SENDER_NAME=PuntOax
# APP_URL=https://puntoax.online

# Asistente virtual con Gemini (solo backend; nunca exponer en frontend ni en Git).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Expiración de sesión por inactividad y duración máxima absoluta (configurables).
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_WARNING_SECONDS=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Google Identity Services: ID PÚBLICO de cliente OAuth tipo "Aplicación web".
# Vacíos = Google deshabilitado; correo/contraseña siguen funcionando.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Lista exacta de orígenes (sin rutas ni barra final). En producción solo HTTPS.
GOOGLE_ALLOWED_ORIGINS=https://puntoax.online
# Vite lee frontend/.env.local para npm run dev; Compose pasa el ID como build arg.
